# Copy this file to .env.local and fill in real values
# Do NOT commit your real secrets to git

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contentful
CONTENTFUL_SPACE_ID=your_space_id
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_ACCESS_TOKEN=your_contentful_access_token

# WooCommerce GraphQL (Required for product data)
# Primary server-side GraphQL endpoint URL (preferred)
WP_GRAPHQL_URL=https://your-woocommerce-site.example/graphql
# Fallback client-side GraphQL endpoint URL (used when WP_GRAPHQL_URL is not available)
NEXT_PUBLIC_WP_GRAPHQL_URL=https://your-woocommerce-site.example/graphql

# WooCommerce REST API (if used)
WC_API_URL=https://your-woocommerce-site.example/wp-json
WC_CONSUMER_KEY=ck_xxx
WC_CONSUMER_SECRET=cs_xxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: Analytics / other services
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Optional: Development settings
# Disable SSL certificate verification for development (use with caution)
# NODE_TLS_REJECT_UNAUTHORIZED=0
